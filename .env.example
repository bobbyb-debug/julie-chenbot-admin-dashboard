# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Signs session cookies. 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Julie ChenBot's admin API (see admin_api/ in the JulieChenBot repo).
# JULIE_API_KEY must match that process's ADMIN_API_KEY exactly.
JULIE_API_URL=
JULIE_API_KEY=

# Optional: where the dashboard's own SQLite database (users, audit log)
# lives. Defaults to ./data. Point this at a persistent volume in production.
DASHBOARD_DATA_DIR=

# Optional: display name shown in the UI. Safe to expose to the browser --
# it's just a label, never a secret. Defaults to "Julie ChenBot Control Room".
NEXT_PUBLIC_APP_NAME=
